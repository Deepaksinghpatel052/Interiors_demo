# Port used by Docker on the server (see .env_server and docker-compose.yml)
APP_PORT=9005

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Demo behaviour
DEMO_MODE=True
LANDING_PAGE=False
DEVNIX_WHATSAPP=919999999999
DEVNIX_NAME=DEVNIXPLUS

# AI assistant (leave key empty or AI_MOCK=True for offline, zero-cost answers)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FALLBACKS=True
AI_MOCK=True
