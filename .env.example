# Copy to .env and fill in. One .env per machine: your PC (local) and the server (Docker).
# Values marked "server:" are what https://interiors.devnixplus.com uses. Never commit .env.

# Port the Docker app listens on (127.0.0.1 only; nginx proxies to it)
APP_PORT=9005

# Django
# server: a long random string — python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
# server: False
DEBUG=True
# server: interiors.devnixplus.com,localhost,127.0.0.1
ALLOWED_HOSTS=127.0.0.1,localhost
# server: uncomment
# CSRF_TRUSTED_ORIGINS=https://interiors.devnixplus.com

# Behind the server's nginx with HTTPS (server: True / True; keep False on your PC)
BEHIND_HTTPS_PROXY=False
TRUST_X_REAL_IP=False

# Demo behaviour
DEMO_MODE=True
LANDING_PAGE=False
DEVNIX_WHATSAPP=919999999999
DEVNIX_NAME=DEVNIXPLUS

# AI assistant (leave key empty or AI_MOCK=True for offline, zero-cost answers)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FALLBACKS=True
AI_MOCK=True

# ---- Docker only (ignored by `manage.py runserver`) ----
TZ=Asia/Kolkata
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
# First start with an empty database: load docker/initial_data/data.json.gz (your saved data)
AUTO_SEED=True
# First start only: the "admin" login gets this password instead of the public demo one (server: set it!)
ADMIN_PASSWORD=
# Daily jobs (Indian time). RESET_DEMO_NIGHTLY=True rebuilds the demo data every night.
AUTOMATIONS_AT=08:00
RESET_AT=03:30
RESET_DEMO_NIGHTLY=False
